---
# Keycloak public route, OpenShift edge.
#
# reencrypt, not edge: Keycloak serves HTTPS in the pod (KC_HTTP_ENABLED=false),
# and the backend leg is verified against the internal CA rather than trusted
# blindly — the same posture Envoy's BackendTLSPolicy gives on k3s.
#
# The hostname must match keycloak_public_base_url, because Keycloak mints its
# issuer and redirect URLs from that value; a mismatch produces OIDC failures
# that surface far away from here (invalid redirect_uri, issuer mismatch).
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: keycloak
  namespace: {{ keycloak_namespace }}
  labels:
    app.kubernetes.io/name: keycloak
    app.kubernetes.io/part-of: armory
{% if keycloak_route_annotations | default({}) | length > 0 %}
  annotations:
{% for key, value in (keycloak_route_annotations | default({})).items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
spec:
  host: {{ keycloak_public_host }}
  to:
    kind: Service
    name: {{ keycloak_service_name }}
    weight: 100
  port:
    targetPort: {{ keycloak_service_https_port }}
  tls:
    termination: reencrypt
    insecureEdgeTerminationPolicy: Redirect
    destinationCACertificate: |-
{{ keycloak_route_destination_ca | indent(6, true) }}
  wildcardPolicy: None
