---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ registry_name }}
  namespace: {{ registry_namespace }}
  labels:
    app.kubernetes.io/name: {{ registry_name }}
    app.kubernetes.io/part-of: armory
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ registry_name }}-data
  namespace: {{ registry_namespace }}
  labels:
    app.kubernetes.io/name: {{ registry_name }}
    app.kubernetes.io/part-of: armory
spec:
  accessModes: ["ReadWriteOnce"]
{% if (registry_storage_class | default('') | trim) | length > 0 %}
  storageClassName: {{ registry_storage_class }}
{% endif %}
  resources:
    requests:
      storage: {{ registry_storage_size }}
---
apiVersion: v1
kind: Service
metadata:
  name: {{ registry_name }}
  namespace: {{ registry_namespace }}
  labels:
    app.kubernetes.io/name: {{ registry_name }}
    app.kubernetes.io/part-of: armory
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: {{ registry_name }}
  ports:
    - name: https
      port: {{ registry_port }}
      targetPort: {{ registry_port }}
      protocol: TCP
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ registry_name }}
  namespace: {{ registry_namespace }}
  labels:
    app.kubernetes.io/name: {{ registry_name }}
    app.kubernetes.io/part-of: armory
spec:
  replicas: {{ registry_replicas }}
  strategy:
    # The data PVC is ReadWriteOnce, so two replicas cannot mount it at once. A
    # rolling update would deadlock: the new pod waits for a volume the old pod
    # still holds.
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ registry_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ registry_name }}
        app.kubernetes.io/part-of: armory
    spec:
      serviceAccountName: {{ registry_name }}
      # No securityContext: the registry binary needs no fixed UID, and OpenShift
      # assigns an fsGroup that makes the data PVC writable. restricted-v2 needs
      # no help.
      containers:
        - name: registry
          image: {{ registry_image }}
          imagePullPolicy: IfNotPresent
          env:
            - name: REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY
              value: /var/lib/registry
            - name: REGISTRY_HTTP_ADDR
              value: "0.0.0.0:{{ registry_port }}"
{% if registry_tls_enabled | bool %}
            - name: REGISTRY_HTTP_TLS_CERTIFICATE
              value: "{{ registry_tls_mount_path }}/tls.crt"
            - name: REGISTRY_HTTP_TLS_KEY
              value: "{{ registry_tls_mount_path }}/tls.key"
{% endif %}
{% if registry_auth_enabled | bool %}
            # Without this the Route would publish an anonymous registry on the
            # cluster ingress: anyone reachable could push an image that our own
            # workloads then pull and run.
            - name: REGISTRY_AUTH
              value: htpasswd
            - name: REGISTRY_AUTH_HTPASSWD_REALM
              value: "{{ registry_auth_realm }}"
            - name: REGISTRY_AUTH_HTPASSWD_PATH
              value: /auth/htpasswd
{% endif %}
          ports:
            - name: https
              containerPort: {{ registry_port }}
          volumeMounts:
            - name: data
              mountPath: /var/lib/registry
{% if registry_tls_enabled | bool %}
            - name: tls
              mountPath: {{ registry_tls_mount_path }}
              readOnly: true
{% endif %}
{% if registry_auth_enabled | bool %}
            - name: auth
              mountPath: /auth
              readOnly: true
{% endif %}
          # TCP, not HTTP. With auth on, the registry answers /v2/ with 401 -- and
          # an httpGet probe only counts 200-399 as success, so an HTTP probe
          # would hold the pod NotReady forever even though it is serving
          # correctly.
          readinessProbe:
            tcpSocket:
              port: {{ registry_port }}
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            tcpSocket:
              port: {{ registry_port }}
            initialDelaySeconds: 15
            periodSeconds: 20
            failureThreshold: 6
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
      volumes:
        - name: data
          persistentVolumeClaim:
            claimName: {{ registry_name }}-data
{% if registry_tls_enabled | bool %}
        - name: tls
          secret:
            secretName: {{ registry_tls_secret_name }}
            defaultMode: 0440
{% endif %}
{% if registry_auth_enabled | bool %}
        - name: auth
          secret:
            secretName: {{ registry_htpasswd_secret_name }}
            defaultMode: 0440
{% endif %}
