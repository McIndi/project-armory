# Environment for the OpenShift target (inventories/openshift).
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# The `set -a` matters: without it these are set in your shell but NOT exported to
# the ansible-playbook child process, so ANSIBLE_ROLES_PATH never reaches Ansible
# and you get "ERROR! the role 'common' was not found".
#
# Most host/domain values that mattered on k3s are now set in
# inventories/openshift/group_vars/all.yml instead, because they derive from the
# cluster's apps domain. What remains here is the environment Ansible itself needs.

# --- Sentry: env_guard refuses to run unless this is present and exact ---------
ARMORY_ENV_SOURCED=armory2-env-loaded-v1

# WARNING: true disables no_log redaction and prints secrets into the log.
ARMORY_LOG_NOLOG=false

# --- Paths --------------------------------------------------------------------
# Clone the repo to ~/project-armory or /opt/project-armory, then set this path
# accordingly.
ARMORY_PROJECT_ROOT=${HOME}/project-armory
ARMORY_ANSIBLE_ROOT=${ARMORY_PROJECT_ROOT}/ansible

# --- Cluster access -----------------------------------------------------------
# The controller is now OUTSIDE the cluster, so everything goes through this
# kubeconfig. Produced by `oc login`. The openshift inventory reads it.
KUBECONFIG=${HOME}/.kube/config

# --- Ansible ------------------------------------------------------------------
# THE line that selects OpenShift. Point this at the development inventory and you
# get the k3s behaviour (which will fail against this cluster).
ANSIBLE_INVENTORY=inventories/openshift/hosts.yml
ANSIBLE_ROLES_PATH=roles
ANSIBLE_HOST_KEY_CHECKING=False
ANSIBLE_RETRY_FILES_ENABLED=False
ANSIBLE_PYTHON_INTERPRETER=auto_silent
ANSIBLE_LOG_PATH=${ARMORY_PROJECT_ROOT}/log/ansible.log
ANSIBLE_DISPLAY_ARGS_TO_STDOUT=True
ANSIBLE_LOAD_CALLBACK_PLUGINS=True
ANSIBLE_CALLBACKS_ENABLED=timer,profile_tasks
ANSIBLE_VERBOSITY=3
ANSIBLE_CALLBACK_RESULT_FORMAT=yaml

# Set true to skip the expensive automation RBAC permission preflight that runs
# from both bootstrap.yml and site.yml. Leave false for normal verification.
ARMORY_AUTOMATION_RBAC_PREFLIGHT_DISABLED=false

# --- PKI ----------------------------------------------------------------------
# The cluster's real apps domain. inventories/openshift/group_vars/all.yml reads
# this to set armory_apps_domain, which every public Route hostname derives from
# (keycloak.<domain>, openbao.<domain>, registry.<domain>). It also names the
# OpenBao external PKI cert role. Public TLS itself comes from the router's Let's
# Encrypt wildcard, so that issuer is largely vestigial on OpenShift, but the name
# should still reflect the real domain.
ARMORY_PUBLIC_DOMAIN=apps.example.com
ARMORY_INTERNAL_PKI_ALLOWED_DOMAINS=svc.cluster.local

# --- Not used on OpenShift ----------------------------------------------------
# Kept only so nothing that still reads them trips over an empty lookup.
#   ARMORY_PUBLIC_BASE_URL   -> set by the inventory (keycloak_public_base_url)
#   ARMORY_OPENBAO_HOST      -> set by the inventory (openbao_ingress_host)
#   ARMORY_HEADLAMP_HOST     -> headlamp is not deployed
#   ARMORY_EDGE_GATEWAY_IP   -> there is no node edge to bind
